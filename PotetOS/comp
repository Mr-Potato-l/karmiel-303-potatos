echo Compiling files!
echo -n .
sleep 0.5
echo -n .
sleep 0.5
echo .
sleep 0.5

i686-elf-as src/boot.s -o src/boot.o
nasm -f elf32 src/gdt_flush.asm -o src/gdt_flush.o
nasm -f elf32 src/idt_flush.asm -o src/idt_flush.o
nasm -f elf32 src/stub_maker.asm -o src/stub_maker.o
i686-elf-gcc -c src/kernel.c -o src/kernel.o -std=gnu99 -ffreestanding -O2 -Wall -Wextra
i686-elf-gcc -c src/gdt.c -o src/gdt.o -std=gnu99 -ffreestanding -O2
i686-elf-gcc -c src/idt.c -o src/idt.o -std=gnu99 -ffreestanding -O2
i686-elf-gcc -c src/interrupts.c -o src/interrupts.o -std=gnu99 -ffreestanding -O2
i686-elf-gcc -c src/terminal.c -o src/terminal.o -std=gnu99 -ffreestanding -O2
i686-elf-gcc -c src/print.c -o src/print.o -std=gnu99 -ffreestanding -O2
echo -e "Files compiled!\n"


echo Linking files!
echo -n .
sleep 0.5
echo -n .
sleep 0.5
echo .
sleep 0.5

i686-elf-gcc -T src/linker.ld -o src/myos.bin -ffreestanding -O2 -nostdlib src/boot.o src/terminal.o src/print.o src/stub_maker.o src/kernel.o src/gdt.o src/gdt_flush.o src/idt.o src/idt_flush.o src/interrupts.o -lgcc

echo -e "Files linked!\n"


echo Creating ISO file!
echo -n .
sleep 0.5
echo -n .
sleep 0.5
echo .
sleep 0.5

mv src/myos.bin isodir/boot/myos.bin
grub-mkrescue -o myos.iso isodir > grub_log.txt 2>&1

echo -e "ISO file created!\n"


echo Removing output files!
echo -n .
sleep 0.5
echo -n .
sleep 0.5
echo .
sleep 0.5

rm src/*.o

echo -e "Output files removed!\n"

echo Booting up the OS. To exit press CTRL+C

qemu-system-i386 -cdrom myos.iso
