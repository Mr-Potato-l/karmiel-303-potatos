i686-elf-as boot.s -o boot.o
nasm -f elf32 gdt_flush.s -o gdt_flush.o
i686-elf-gcc -c kernel.c -o kernel.o -std=gnu99 -ffreestanding -O2 -Wall -Wextra
i686-elf-gcc -c gdt.c -o gdt.o -std=gnu99 -ffreestanding -O2
i686-elf-gcc -T linker.ld -o myos.bin -ffreestanding -O2 -nostdlib boot.o kernel.o gdt.o gdt_flush.o -lgcc
mv myos.bin ../isodir/boot/myos.bin
grub-mkrescue -o ../myos.iso ../isodir
rm boot.o
rm kernel.o
rm gdt.o
rm gdt_flush.o
